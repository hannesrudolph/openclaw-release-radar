[Unit]
Description=OpenClaw Release Radar
After=network-online.target openclaw-release-radar-reconcile-boot.service
Wants=network-online.target
Requires=openclaw-release-radar-reconcile-boot.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/openclaw-release-radar/current
Environment=NODE_ENV=production
Environment=PATH=/opt/node-v24/bin:/usr/local/bin:/usr/bin:/bin
UnsetEnvironment=DB_PATH PORT REFRESH_ON_STARTUP REFRESH_MINUTES RADAR_CODE_REVISION CODE_REVISION DOTENV_CONFIG_PATH DOTENV_CONFIG_OVERRIDE RADAR_DB_READ_ONLY RADAR_DB_BOOTSTRAP_MODE
UnsetEnvironment=NODE_OPTIONS NODE_PATH BASH_ENV ENV SHELLOPTS BASHOPTS PS4 BASH_XTRACEFD CDPATH GLOBIGNORE POSIXLY_CORRECT
UnsetEnvironment=LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT DYLD_INSERT_LIBRARIES DYLD_LIBRARY_PATH DYLD_FRAMEWORK_PATH
UnsetEnvironment=DYLD_FALLBACK_LIBRARY_PATH DYLD_FALLBACK_FRAMEWORK_PATH OPENSSL_CONF OPENSSL_MODULES
UnsetEnvironment=NODE_EXTRA_CA_CERTS NODE_TLS_REJECT_UNAUTHORIZED SSL_CERT_FILE SSL_CERT_DIR
UnsetEnvironment=NPM_CONFIG_NODE_OPTIONS npm_config_node_options NPM_CONFIG_SCRIPT_SHELL npm_config_script_shell
ExecStartPre=/usr/bin/env -i NODE_ENV=production PATH=/opt/node-v24/bin:/usr/local/bin:/usr/bin:/bin /opt/node-v24/bin/node /opt/openclaw-release-radar/current/dist/index.js --print-effective-config
ExecStartPre=/usr/bin/env -i NODE_ENV=production PATH=/opt/node-v24/bin:/usr/local/bin:/usr/bin:/bin /opt/node-v24/bin/node /opt/openclaw-release-radar/current/dist/index.js --verify-startup-authorization
ExecStart=/usr/bin/env -i NODE_ENV=production PATH=/opt/node-v24/bin:/usr/local/bin:/usr/bin:/bin /opt/node-v24/bin/node /opt/openclaw-release-radar/current/dist/index.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
UMask=0027
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
