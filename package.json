{
  "name": "openclaw-release-radar",
  "version": "0.1.0",
  "description": "Release stability monitor for openclaw/openclaw — polls GitHub issues, scores releases via LLM.",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "NODE_ENV=production node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test:safety": "/usr/bin/env -u NODE_OPTIONS -u NODE_PATH -u npm_lifecycle_event node --no-global-search-paths test/run-database-guard.mjs",
    "test:preflight": "/usr/bin/env -u NODE_OPTIONS -u NODE_PATH -u npm_lifecycle_event node --no-global-search-paths --no-warnings test/run-installer-preflight.mjs",
    "test:focus": "/usr/bin/env -u NODE_OPTIONS -u NODE_PATH -u npm_lifecycle_event node --no-global-search-paths --no-warnings test/run-focused-test.mjs",
    "test": "/usr/bin/env -u NODE_OPTIONS -u NODE_PATH -u npm_lifecycle_event node --no-global-search-paths test/run-tests.mjs",
    "test:baseline": "/usr/bin/env -u NODE_OPTIONS -u NODE_PATH -u npm_lifecycle_event node --no-global-search-paths test/generate-test-baseline.mjs",
    "test:baseline:accept": "/usr/bin/env -u NODE_OPTIONS -u NODE_PATH -u npm_lifecycle_event node --no-global-search-paths test/accept-test-baseline.mjs",
    "verify:scripts": "for f in scripts/*.mjs scripts/lib/*.mjs scripts/validation/*.mjs test/*.mjs test/*.cjs; do node --check \"$f\" || exit 1; done",
    "verify:authoritative-ci": "/usr/bin/env -u NODE_OPTIONS -u NODE_PATH -u npm_lifecycle_event npm run test:safety && /usr/bin/env -u NODE_OPTIONS -u NODE_PATH -u npm_lifecycle_event npm run test:baseline -- --full --rerun",
    "verify:ci": "npm run typecheck && npm run verify:scripts && npm run build",
    "verify:local": "npm run doctor -- --fail-on-warnings && npm run verify:score -- --all && npm run verify:release-audit -- --all",
    "verify:live": "tsx scripts/verify-live.mjs --api-base http://127.0.0.1:8787 && npm run doctor -- --fail-on-warnings --api-base http://127.0.0.1:8787 && npm run verify:score -- --all && npm run verify:release-audit -- --all --api-base http://127.0.0.1:8787 && npm run ui:smoke",
    "doctor": "tsx scripts/doctor.mjs",
    "scrape:upstream": "tsx scripts/scrape-upstream-webui.mjs",
    "ingest:fix-provenance": "tsx scripts/ingest-fix-provenance.mjs",
    "check:release-pr-reachability": "tsx scripts/check-release-pr-reachability.mjs",
    "analyze:closure-proofs": "tsx scripts/analyze-closure-proofs.mjs",
    "verify:release-audit": "tsx scripts/verify-release-audit-invariants.mjs",
    "verify:score": "tsx scripts/verify-new-scoring.mjs --check",
    "score:preview": "tsx scripts/preview-score.mjs",
    "ui:smoke": "tsx scripts/ui-smoke.mjs",
    "backfill:issue-comment-snapshots": "tsx scripts/backfill-issue-comment-snapshots.mjs",
    "backfill:closed-windows": "tsx scripts/backfill-closed-windows.mjs",
    "backfill:issue-state-events": "tsx scripts/backfill-issue-state-events.mjs",
    "refresh:quality": "tsx scripts/refresh-quality-db.mjs",
    "validation:snapshot": "tsx scripts/validation/snapshot-forecast.mjs",
    "validation:opportunities": "tsx scripts/validation/forecast-opportunity-status.mjs",
    "validation:observe": "tsx scripts/validation/observe-outcomes.mjs",
    "validation:evaluate": "tsx scripts/validation/evaluate-score-quality.mjs",
    "promote:quality-db": "tsx scripts/promote-quality-db.mjs"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.5",
    "playwright": "^1.61.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
