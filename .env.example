# OpenClaw repo
GITHUB_OWNER=openclaw
GITHUB_REPO=openclaw

# GitHub PAT (read-only, public_repo scope). Optional but raises rate limits 60 → 5000/h.
GITHUB_TOKEN=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Server
PORT=8787
DB_PATH=./data/radar.db

# Cron schedule (every 20 minutes by default)
REFRESH_CRON=*/30 * * * *

# How many recent issues to (re)analyze per refresh
ISSUES_LIMIT=80

# How many releases to score and show (only stable releases — prereleases are filtered out)
RELEASES_LIMIT=10

# If set, POST /api/refresh requires X-Admin-Token: <value> header
ADMIN_TOKEN=
