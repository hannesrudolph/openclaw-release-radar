# Local development and isolated quality-DB template.
# Production does not copy this file: the installer reads
# /opt/openclaw-release-radar/shared/.env and binds the verified release
# revision in a separate per-release runtime env.
#
# dotenv fills only unset keys. Every inherited process variable overrides the
# matching value here, including DB_PATH, model, refresh, and server settings.

# OpenClaw repo
GITHUB_OWNER=openclaw
GITHUB_REPO=openclaw
OPENCLAW_REPO_URL=https://github.com/openclaw/openclaw.git

# GitHub PAT (read-only, public_repo scope). Required for GraphQL refreshes.
# You can also set GITHUB_PERSONAL_ACCESS_TOKEN globally instead.
GITHUB_TOKEN=

# Shared GitHub GraphQL transport limits and retry/cooldown timing.
GITHUB_GRAPHQL_CONCURRENCY=2
GITHUB_GRAPHQL_MIN_START_SPACING_MS=250
GITHUB_GRAPHQL_RETRY_BASE_MS=15000
GITHUB_GRAPHQL_RETRY_MAX_MS=300000
GITHUB_GRAPHQL_COOLDOWN_BASE_MS=30000
GITHUB_GRAPHQL_COOLDOWN_MAX_MS=300000
GITHUB_GRAPHQL_REQUEST_TIMEOUT_MS=30000
GITHUB_GRAPHQL_BODY_TIMEOUT_MS=30000
GITHUB_GRAPHQL_MAX_PAGES_PER_CONNECTION=8192

# OpenAI
# You can also set OC_OPENAI_API_KEY globally instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=medium
# OpenAI's API name for the fast processing tier is "priority".
# The response model must match exactly, except that an unversioned request may
# resolve to the same model plus a -YYYY-MM-DD suffix. Any other returned model
# or any returned service-tier mismatch is a hard classification failure.
OPENAI_SERVICE_TIER=priority
OPENAI_REQUEST_TIMEOUT_MS=300000
OPENAI_MAX_ATTEMPTS=5
OPENAI_RETRY_BASE_MS=1000
OPENAI_RETRY_MAX_MS=30000

# Server
PORT=8787
DB_PATH=./data/radar-quality.db
# Deployable quality workflows must override this with the exact raw deployment
# commit SHA for refresh, read-only preview, observation, and evaluation. Do not
# use a git: prefix or a dirty-worktree identity. The production installer
# rejects this key in shared/.env and creates a release-specific value from the
# verified manifest SHA.
RADAR_CODE_REVISION=

# Optional absolute paths for the signed approved-maintainer roster contract.
# The keyring file is operator-restricted and contains base64 HMAC key material;
# key material is never copied into snapshots, hashes, receipts, or errors.
# The state file stores only the last accepted repository node ID, sequence, and
# roster run digest so rollback, replay, forks, and sequence gaps fail closed.
LABEL_AUTHORITY_APPROVED_ROSTER_PATH=
LABEL_AUTHORITY_APPROVED_ROSTER_KEYRING_PATH=
LABEL_AUTHORITY_APPROVED_ROSTER_STATE_PATH=

# Refresh controls. Keep both disabled while calibrating; run refresh manually.
REFRESH_ON_STARTUP=false
REFRESH_MINUTES=0

# How many releases to score and show (only stable releases; prereleases are filtered out).
RELEASES_LIMIT=10

# Compatibility/audit marker only. Score-producing refreshes currently force an
# exhaustive stabilized issue-catalog pass regardless of this value.
FULL_ISSUE_BACKFILL=false
MAX_ISSUE_PAGES=4096
GITHUB_ISSUE_PAGE_SIZE=25
ISSUE_CATALOG_SNAPSHOT_MAX_AGE_HOURS=24
CLASSIFY_CONCURRENCY=5
GITHUB_GRAPHQL_PAGE_DELAY_MS=0
RELEASE_NETWORK_CONCURRENCY=4
CLOSURE_EVIDENCE_CONCURRENCY=3
CLOSURE_PROOF_CONCURRENCY=4
GIT_REACHABILITY_CONCURRENCY=16
GIT_CACHE_MAX_PACKS=64
GIT_CACHE_MAX_SIZE_MIB=2048
GIT_CACHE_MAINTENANCE_TIMEOUT_MS=300000
OPEN_PR_REFRESH_MINUTES=15
CLOSED_PR_REFRESH_MINUTES=1440

# Internal calibration only. Keep false for product UX.
COMPARISON_API_ENABLED=false

# Deployment/promotion coordination. Export the same absolute path for the
# server installer and promote:quality-db; this is not an application setting.
RADAR_DEPLOY_LOCK_PATH=/opt/openclaw-release-radar/shared/deploy-promotion.lock
RADAR_DEPLOY_LOCK_TIMEOUT_SECONDS=120

# GitHub Actions repository variables used by deploy-radar.yml, not application
# environment variables. DEPLOY_REQUIRED_PROMOTION_RECEIPT_ID has no default.
# DEPLOY_HEALTH_URL=https://your-domain.example/api/health
# DEPLOY_MAX_SCORE_AGE_HOURS=24
# DEPLOY_MAX_REFRESH_AGE_HOURS=24
# DEPLOY_QUALITY_DB_PATH=/absolute/server/path/to/verified-quality.db
# DEPLOY_REQUIRED_PROMOTION_RECEIPT_ID=
