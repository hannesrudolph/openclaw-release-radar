# OpenClaw repo
GITHUB_OWNER=openclaw
GITHUB_REPO=openclaw

# GitHub PAT (read-only, public_repo scope). Required for GraphQL refreshes.
GITHUB_TOKEN=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Server
PORT=8787
DB_PATH=./data/radar.db

# How often to refresh (minutes between runs). Allowed range: 1..600.
REFRESH_MINUTES=30

# How many releases to score and show (only stable releases — prereleases are filtered out)
RELEASES_LIMIT=10
